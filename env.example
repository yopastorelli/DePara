# DePara - ambiente local Windows
# Copie somente as chaves necessárias para %USERPROFILE%\.depara\config.env.

# HTTP
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
MAX_PAYLOAD=25mb

# Runtime persistente
# Se omitido, o aplicativo usa %USERPROFILE%\.depara automaticamente.
# DEPARA_RUNTIME_ROOT=C:\Users\<usuario>\.depara
# DEPARA_CONFIG_ENV_PATH=C:\Users\<usuario>\.depara\config.env
# DEPARA_DATA_DIR=C:\Users\<usuario>\.depara\data
# DEPARA_CONFIG_FILE=C:\Users\<usuario>\.depara\data\depara-config.json
# DEPARA_LOG_DIR=C:\Users\<usuario>\.depara\logs
# LOG_FILE=C:\Users\<usuario>\.depara\logs\app.log
# DEPARA_BACKUP_DIR=C:\Users\<usuario>\.depara\backups
# DEPARA_TEMP_DIR=C:\Users\<usuario>\.depara\temp
# DEPARA_RUNTIME_PUBLIC_DIR=C:\Users\<usuario>\.depara\public
# DEPARA_RELEASES_DIR=C:\Users\<usuario>\.depara\releases
# DEPARA_CURRENT_DIR=C:\Users\<usuario>\.depara\current

# Logging e diagnósticos
LOG_LEVEL=warn
LOG_TO_CONSOLE=false
LOG_BUFFER_SIZE=10
LOG_FLUSH_INTERVAL=5000
# Ative somente durante diagnóstico local.
DEPARA_HTTP_LOGGING=false
DEPARA_REQUEST_METADATA_LOGGING=false

# Limites de segurança e memória
# Use ; para separar múltiplos caminhos no Windows.
# DEPARA_ALLOWED_PATHS=C:\Users\<usuario>\Documents;D:\Dados
MAX_CONCURRENT_OPERATIONS=2
MAX_RECURSION_DEPTH=20
# Limita a quantidade de imagens mantida em memória por consulta.
# DEPARA_MAX_IMAGE_RESULTS=5000

# Rate limits
DEPARA_STRICT_RATE_LIMIT=20
DEPARA_NORMAL_RATE_LIMIT=300
DEPARA_READ_RATE_LIMIT=1000
DEPARA_SLIDESHOW_RATE_LIMIT=1000
# DEPARA_DISABLE_RATE_LIMITS=true

# Atualização local: desativada por padrão; exige decisão explícita.
# DEPARA_ENABLE_UPDATE_SCHEDULER=true
# DEPARA_UPDATE_SOURCE_ROOT=C:\DePara
# DEPARA_DISABLE_UPDATE_SIDE_EFFECTS=true
# DEPARA_DISABLE_UPDATE_SCHEDULER=true
# DEPARA_DISABLE_PROCESS_HOOKS=true

# Integrações opcionais
# DEPARA_APP_URL=http://127.0.0.1:3000

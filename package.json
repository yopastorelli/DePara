{
  "name": "depara",
  "version": "2.0.0",
  "description": "DePara - Gerenciador Automatizado de Arquivos com Slideshow de Imagens",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:windows": "node scripts/start-windows.js",
    "runtime:bootstrap": "node bootstrap-runtime-release.js",
    "start:bg": "npm run runtime:bootstrap && pm2 start ecosystem.config.js --env production",
    "start:bg:prod": "npm run runtime:bootstrap && pm2 start ecosystem.config.js --env production",
    "stop:bg": "pm2 stop DePara",
    "restart:bg": "pm2 restart DePara --update-env",
    "status": "pm2 status",
    "logs": "pm2 logs DePara",
    "dev": "node --watch src/main.js",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.unit.config.js --runInBand --forceExit",
    "test:platform": "jest --config jest.unit.config.js --runInBand tests/unit/platform --forceExit",
    "test:smoke": "jest --runInBand tests/smoke --forceExit",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test:unit && npm run test:smoke && npm run test:e2e && npm audit --audit-level=high",
    "test:watch": "jest --config jest.unit.config.js --watch",
    "test:coverage": "jest --config jest.unit.config.js --runInBand --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "setup": "npm install",
    "setup:bg": "npm install && npm install -g pm2",
    "postinstall": "node -e \"console.log('✅ DePara instalado com sucesso. Use npm start, npm run start:windows ou o supervisor da plataforma.')\""
  },
  "keywords": [
    "file-manager",
    "slideshow",
    "automation",
    "backup",
    "raspberry-pi",
    "nodejs",
    "express",
    "depara"
  ],
  "author": "yopastorelli",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "eslint": "^10.5.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.2.2"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

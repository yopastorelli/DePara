HOST=127.0.0.1
PORT=3001
NODE_ENV=production
DEPARA_RUNTIME_ROOT=C:\ProgramData\DePara
DEPARA_CONFIG_ENV_PATH=C:\ProgramData\DePara\config.env
DEPARA_DATA_DIR=C:\ProgramData\DePara\data
DEPARA_LOG_DIR=C:\ProgramData\DePara\logs
DEPARA_BACKUP_DIR=C:\ProgramData\DePara\backups
DEPARA_TEMP_DIR=C:\ProgramData\DePara\temp
DEPARA_RELEASES_DIR=C:\ProgramData\DePara\releases
DEPARA_CURRENT_DIR=C:\ProgramData\DePara\current
DEPARA_PLATFORM_TARGET=windows
DEPARA_WINDOWS_SERVICE=true
DEPARA_DISABLE_UPDATE_SCHEDULER=true
DEPARA_ALLOW_SYSTEMD_FALLBACK=false
LOG_LEVEL=warn
LOG_TO_CONSOLE=false
# Use semicolon between allowed Windows roots.
# Prefer UNC paths for network shares used by the service.
# DEPARA_ALLOWED_PATHS=C:\Users;D:\Media;\\server\share
